{
  "name": "nucleo-saude-gestao",
  "version": "1.0.0",
  "scripts": {
    "dev": "npx serve . -l 3000",
    "start": "npx serve .",
    "prebuild": "node -e \"const fs=require('fs');try{fs.rmSync('dist',{recursive:true,force:true})}catch(_){}\"",
    "build": "node -e \"const fs=require('fs'),cp=require('child_process');fs.mkdirSync('dist/app',{recursive:true});['icons','ui','tweaks-panel','data','extras','sidebar','login','dashboard','pendencias','demandas','equipe','feedback','usuarios','perfil','main'].forEach(f=>{cp.execSync('npx babel app/'+f+'.jsx -o dist/app/'+f+'.js',{stdio:'inherit'})})\"",
    "serve:prod": "npx serve . -l 3000"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5"
  }
}
